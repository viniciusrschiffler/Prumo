{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-dom",
                  "react/*",
                  "react-dom/*",
                  "react-router*",
                  "zustand",
                  "zustand/*",
                  "@tauri-apps/*",
                  "@/ui/*",
                  "@/app/*",
                  "@/infra/*"
                ],
                "message": "domain/ não pode depender de React, Tauri nem das outras camadas."
              }
            ]
          }
        ]
      }
    }
  ]
}
